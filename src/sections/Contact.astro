---
import Section from "../components/Section.astro";
import BrandIcon from "../components/BrandIcon.astro";

const primary = [
  {
    brand: "linkedin" as const,
    label: "LinkedIn",
    sub: "Our main channel. Daily posts across innovation, fundraising, product, founder craft, and policy.",
    href: "https://www.linkedin.com/company/the-startup-club-india",
    cta: "Follow on LinkedIn",
    accent: true,
  },
  {
    brand: "x" as const,
    label: "X",
    sub: "Sharp, real-time signal — what's breaking in Indian startups, who's funding what, what the discourse is.",
    href: "https://x.com/startupclublive",
    cta: "Follow on X",
    accent: false,
  },
  {
    brand: "instagram" as const,
    label: "Instagram",
    sub: "Visual takes on founder craft and ecosystem moments. Easier to share, easier to skim.",
    href: "https://www.instagram.com/startupclub.live/",
    cta: "Follow on Instagram",
    accent: false,
  },
];
---

<Section
  id="contact"
  eyebrow="Follow"
  title="Follow the conversation."
  intro="Pick whichever channel you already live on — LinkedIn for the long form, X for the signal, Instagram for the visuals. We publish on all three."
>
  <div class="grid sm:grid-cols-3 gap-5">
    {primary.map((c) => (
      <a
        href={c.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`group block rounded-2xl border p-6 sm:p-7 no-underline transition-colors ${
          c.accent
            ? "bg-[color:var(--color-accent)] border-[color:var(--color-accent)] text-white hover:bg-[color:var(--color-accent-hover)]"
            : "bg-[color:var(--color-bg-elev)] border-[color:var(--color-line)] hover:border-[color:var(--color-accent)]"
        }`}
      >
        <div class={`flex items-center gap-2 text-[12px] tracking-[0.14em] uppercase font-semibold mb-3 ${c.accent ? "text-white/85" : "text-[color:var(--color-ink)]"}`}>
          <BrandIcon
            brand={c.brand}
            size={18}
            class={c.accent ? "text-white" : "text-[color:var(--color-ink)]"}
          />
          <span>{c.label}</span>
        </div>
        <div class={`text-[15.5px] leading-relaxed ${c.accent ? "text-white/95" : "text-[color:var(--color-ink-muted)]"}`}>
          {c.sub}
        </div>
        <div class={`mt-5 inline-flex items-center gap-1 text-[14px] font-semibold ${c.accent ? "text-white" : "text-[color:var(--color-ink)]"}`}>
          {c.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</Section>
