---
import Section from "../components/Section.astro";
import BrandIcon from "../components/BrandIcon.astro";

const primary = [
  {
    brand: "linkedin" as const,
    label: "LinkedIn",
    sub: "Our main feed. Daily posts across innovation, fundraising, product, founder craft, and policy.",
    href: "https://www.linkedin.com/company/the-startup-club-india",
    cta: "Follow on LinkedIn",
    accent: true,
  },
  {
    brand: "x" as const,
    label: "X",
    sub: "Sharp, real-time signal — what's breaking in Indian startups and who's funding what.",
    href: "https://x.com/startupclublive",
    cta: "Follow on X",
    accent: false,
  },
  {
    brand: "instagram" as const,
    label: "Instagram",
    sub: "Visual takes on founder craft and ecosystem moments. Easier to share, easier to skim.",
    href: "https://www.instagram.com/startupclub.live/",
    cta: "Follow on Instagram",
    accent: false,
  },
];

const forms = [
  {
    eyebrow: "For founders",
    title: "Request mentorship",
    body: "Fill out the form and we'll match you with a mentor from the community based on your stage and the problem you're working through.",
    href: "https://forms.gle/G5HDgSs9Xckac2g26",
    cta: "Open the form",
  },
  {
    eyebrow: "For founders",
    title: "Pitch to an investor",
    body: "Send us your one-pager. We route fits to angels and funds in the community who are actively looking at that stage and theme.",
    href: "https://forms.gle/j8K3NPiyEVkBEsJt6",
    cta: "Open the form",
  },
];

type ChannelChip = {
  brand: "whatsapp" | "telegram";
  label: string;
  href: string;
};

const communityChannels: ChannelChip[] = [
  { brand: "whatsapp", label: "WhatsApp", href: "https://chat.whatsapp.com/Keb65USjRvaAbPQby6dwt1" },
  { brand: "telegram", label: "Telegram", href: "https://t.me/+2p31iaNtAxsyN2E1" },
];
---

<Section
  id="contact"
  eyebrow="Follow"
  title="Follow the daily feed."
  intro="LinkedIn for the long form, X for the signal, Instagram for the visuals. We publish on all three."
>
  <div class="grid sm:grid-cols-3 gap-5">
    {primary.map((c) => (
      <a
        href={c.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`group block rounded-2xl border p-6 sm:p-7 no-underline transition-colors ${
          c.accent
            ? "bg-[color:var(--color-accent)] border-[color:var(--color-accent)] text-white hover:bg-[color:var(--color-accent-hover)]"
            : "bg-[color:var(--color-bg-elev)] border-[color:var(--color-line)] hover:border-[color:var(--color-accent)]"
        }`}
      >
        <div class={`flex items-center gap-2 text-[12px] tracking-[0.14em] uppercase font-semibold mb-3 ${c.accent ? "text-white/85" : "text-[color:var(--color-ink)]"}`}>
          <BrandIcon
            brand={c.brand}
            size={18}
            class={c.accent ? "text-white" : "text-[color:var(--color-ink)]"}
          />
          <span>{c.label}</span>
        </div>
        <div class={`text-[15px] leading-relaxed ${c.accent ? "text-white/95" : "text-[color:var(--color-ink-muted)]"}`}>
          {c.sub}
        </div>
        <div class={`mt-5 inline-flex items-center gap-1 text-[14px] font-semibold ${c.accent ? "text-white" : "text-[color:var(--color-ink)]"}`}>
          {c.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>

  <div class="mt-12 grid lg:grid-cols-2 gap-5">
    {forms.map((f) => (
      <div class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-6 sm:p-7">
        <div class="text-[12px] tracking-[0.14em] uppercase text-[color:var(--color-ink-soft)] font-semibold mb-2">{f.eyebrow}</div>
        <h3 class="text-xl font-bold tracking-tight">{f.title}</h3>
        <p class="mt-2 text-[15px] text-[color:var(--color-ink-muted)] leading-relaxed">{f.body}</p>
        <a href={f.href} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-1 text-[14px] font-semibold no-underline text-[color:var(--color-ink)]">
          {f.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    ))}
  </div>

  <div class="mt-12">
    <div class="text-[12px] tracking-[0.14em] uppercase text-[color:var(--color-ink-soft)] font-semibold mb-3">Community channels</div>
    <p class="text-[14px] text-[color:var(--color-ink-muted)] mb-3 leading-relaxed max-w-2xl">
      Day-to-day chat with founders, mentors, and operators in the community.
    </p>
    <div class="flex flex-wrap gap-2.5">
      {communityChannels.map((c) => (
        <a
          href={c.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] px-3.5 py-1.5 text-[13.5px] font-medium text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink)] hover:border-[color:var(--color-ink)] no-underline transition-colors"
        >
          <BrandIcon brand={c.brand} size={14} />
          {c.label}
        </a>
      ))}
    </div>
  </div>
</Section>
