---
import Section from "../components/Section.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
---

<Section
  id="blog"
  eyebrow="Blog"
  title="Notes from the ecosystem."
  intro="Longer reads on what we're seeing across Indian startups — patterns from the field, breakdowns of what's working, and frameworks worth keeping."
  tone="soft"
>
  {posts.length === 0 ? (
    <p class="text-[color:var(--color-ink-muted)]">No posts yet. Check back soon.</p>
  ) : (
    <div class="grid sm:grid-cols-2 gap-5">
      {posts.map((p) => (
        <BlogCard
          href={`/blog/${p.slug}/`}
          title={p.data.title}
          date={p.data.date.toISOString()}
          excerpt={p.data.excerpt}
          tags={p.data.tags}
        />
      ))}
    </div>
  )}
</Section>
