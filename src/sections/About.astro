---
import Section from "../components/Section.astro";

const linkedinUrl = "https://www.linkedin.com/company/the-startup-club-india";

const audiences = [
  {
    title: "Early-stage founders",
    body: "Building from idea or seed; looking for sharper takes on product, fundraising, and the operating decisions that compound.",
  },
  {
    title: "Aspiring entrepreneurs",
    body: "Working on side projects or planning your first move. Learn from the people one or two stages ahead of you.",
  },
  {
    title: "Investors",
    body: "Angels, syndicate leads, and institutional folks tracking what's getting built across Indian innovation.",
  },
  {
    title: "Mentors and operators",
    body: "Senior operators and ex-founders who pay the experience forward — guiding portfolios, advising cohorts, or building in public.",
  },
  {
    title: "Ecosystem enablers",
    body: "Incubators, accelerators, community builders, policy and academia — the connective tissue around founders.",
  },
];
---

<Section
  id="about"
  eyebrow="About"
  title="A community for the people building India's startup ecosystem."
  intro="The Startup Club exists because the most useful conversations happen between the people doing the work — founders comparing notes, investors sharing pattern-matching, mentors and operators paying forward what they learned. Events, video, and daily social are all entry points into the same community."
>
  <div class="mx-auto max-w-3xl">
    <h3 class="text-xl font-bold tracking-tight">Who it's for</h3>
    <ul class="mt-4 grid sm:grid-cols-2 gap-3">
      {audiences.map((a) => (
        <li class="rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-4 sm:p-5">
          <div class="font-semibold text-[15.5px]">{a.title}</div>
          <div class="text-[14.5px] text-[color:var(--color-ink-muted)] leading-relaxed mt-1">{a.body}</div>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-[14.5px] text-[color:var(--color-ink-muted)]">
      If any of that sounds like you, head back up to find the right way in — watch on YouTube, join a virtual session on Meetup, attend in person via AllEvents, or follow along on
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="font-semibold">LinkedIn</a>, X, and Instagram.
    </p>
  </div>
</Section>
