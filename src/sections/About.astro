---
import Section from "../components/Section.astro";

const topicForm = "https://forms.gle/xggwN2CQ7VmA6dkr8";

const steps = [
  {
    n: "01",
    title: "Anyone suggests a topic",
    body: "Members fill out our topic-suggestion form to propose what they'd like the community to debate next.",
  },
  {
    n: "02",
    title: "The community votes",
    body: "We periodically post polls in the WhatsApp group. Members vote, and the topics with the most support move forward.",
  },
  {
    n: "03",
    title: "We schedule on Meetup",
    body: "Winning topics are scheduled as upcoming Saturday sessions on our Meetup page so anyone can RSVP and prepare.",
  },
  {
    n: "04",
    title: "Live debate, every Saturday",
    body: "We meet on Zoom at 11am IST. The Zoom link for each session is published on the Meetup event page. All perspectives welcome — listen, speak, or both.",
  },
];

const principles = [
  {
    title: "All perspectives welcome",
    body: "We are a neutral platform. No side of any topic is endorsed; every viewpoint is heard on its own merits.",
  },
  {
    title: "Civility over heat",
    body: "We disagree with ideas, not people. Personal attacks, slurs, and bad-faith argument have no place here.",
  },
  {
    title: "Listen first, then speak",
    body: "The point of a debate is to understand the strongest version of the other side, not just to win.",
  },
];
---

<Section
  id="about"
  eyebrow="About"
  title="Bi-directional public discourse, by design."
  intro="Most of today's public conversation runs through a broadcaster-and-consumer model — a publisher pushes out a narrative, and the rest of us consume it without a way to shape it. The Debate Club exists to flip that. We're a neutral facilitator where people from any perspective get a real seat at the table to shape the conversation."
>
  <div class="grid lg:grid-cols-[1fr_1.05fr] gap-10 lg:gap-16">
    <div>
      <h3 class="text-xl font-bold tracking-tight">Why we exist</h3>
      <p class="mt-3 text-[15.5px] text-[color:var(--color-ink-muted)] leading-relaxed">
        Public narrative is being shaped by fewer and fewer voices, and most people have no avenue to participate in shaping it — only to react. We believe a healthy society needs democratized access to that conversation: anyone, on any side of a topic, should be able to contribute their perspective in good faith and have it actually heard.
      </p>
      <p class="mt-3 text-[15.5px] text-[color:var(--color-ink-muted)] leading-relaxed">
        The Debate Club is our small, persistent attempt at that — a weekly room where civil public discourse actually happens.
      </p>

      <h3 class="text-xl font-bold tracking-tight mt-10">What we do</h3>
      <p class="mt-3 text-[15.5px] text-[color:var(--color-ink-muted)] leading-relaxed">
        We're an online community anchored on WhatsApp. Every Saturday at 11am IST we run a live voice debate on a topic the community has chosen. The day-to-day chat — topic suggestions, polls, announcements — happens in our <a href="https://chat.whatsapp.com/J7HajIvMSUfLnS0W47Un7M" target="_blank" rel="noopener noreferrer">WhatsApp Community</a>. The live Saturday session itself runs on <strong>Zoom</strong>; the Zoom link for each upcoming debate is posted on the corresponding event on our <a href="https://www.meetup.com/the-debate-club/" target="_blank" rel="noopener noreferrer">Meetup page</a>.
      </p>
    </div>

    <div>
      <h3 class="text-xl font-bold tracking-tight">How it works</h3>
      <ol class="mt-4 space-y-4">
        {steps.map((s) => (
          <li class="flex gap-4 rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-4 sm:p-5">
            <div class="text-[13px] font-bold tracking-widest text-[color:var(--color-accent)] pt-0.5">{s.n}</div>
            <div>
              <div class="font-semibold text-[15.5px]">{s.title}</div>
              <div class="text-[14.5px] text-[color:var(--color-ink-muted)] leading-relaxed mt-1">{s.body}</div>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-5 text-[14.5px] text-[color:var(--color-ink-muted)]">
        Have an idea?
        <a href={topicForm} target="_blank" rel="noopener noreferrer" class="font-semibold">Suggest a topic →</a>
      </p>
    </div>
  </div>

  <div class="mt-16 sm:mt-20">
    <h3 class="text-xl font-bold tracking-tight">Code of conduct</h3>
    <div class="mt-5 grid sm:grid-cols-3 gap-4">
      {principles.map((p) => (
        <div class="rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-5">
          <div class="font-semibold text-[15.5px]">{p.title}</div>
          <div class="text-[14.5px] text-[color:var(--color-ink-muted)] leading-relaxed mt-2">{p.body}</div>
        </div>
      ))}
    </div>
    <p class="mt-8 text-[13.5px] text-[color:var(--color-ink-soft)] leading-relaxed max-w-3xl">
      <strong class="text-[color:var(--color-ink-muted)]">Disclaimer.</strong>
      The views expressed in our sessions are those of individual participants and do not represent the views of The Debate Club as a platform. We facilitate the conversation; we do not endorse any side of it.
    </p>
  </div>
</Section>
