---
import BrandIcon from "../components/BrandIcon.astro";

const youtubeUrl = "https://www.youtube.com/@startupclublive";
const meetupUrl = "https://www.meetup.com/the-startup-club/";
const alleventsUrl = "https://allevents.by/25026079";

const linkedinUrl = "https://www.linkedin.com/company/the-startup-club-india";
const xUrl = "https://x.com/startupclublive";
const instagramUrl = "https://www.instagram.com/startupclub.live/";

const featured = [
  {
    brand: "youtube" as const,
    eyebrow: "Watch",
    label: "YouTube",
    sub: "Founder conversations, breakdowns, and event recordings — long-form video on @startupclublive.",
    href: youtubeUrl,
  },
  {
    brand: "meetup" as const,
    eyebrow: "Join virtually",
    label: "Meetup",
    sub: "Live virtual events — talks, panels, and AMAs you can join from anywhere. RSVP for the next session.",
    href: meetupUrl,
  },
  {
    brand: "allevents" as const,
    eyebrow: "Attend in person",
    label: "AllEvents",
    sub: "Live in-person events across India — meetups and ecosystem gatherings. Find the next one near you.",
    href: alleventsUrl,
  },
];
---

<section id="home" class="scroll-mt-20">
  <div class="mx-auto max-w-[1120px] px-5 sm:px-8 pt-12 sm:pt-16 lg:pt-20 pb-14 sm:pb-20">
    <div class="grid lg:grid-cols-[auto_1fr] gap-8 lg:gap-14 items-center">
      <img
        id="hero-logo"
        src="/images/tsc-logo.png"
        alt="The Startup Club"
        width="480"
        height="480"
        class="block w-40 sm:w-52 lg:w-60 h-auto rounded-full bg-[color:var(--color-ink)] ring-1 ring-[color:var(--color-line)] shrink-0"
      />
      <div class="max-w-[44rem]">
        <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] px-3 py-1 text-[12px] font-semibold tracking-wide uppercase text-[color:var(--color-ink)] mb-7">
          <span class="h-2 w-2 rounded-full bg-[color:var(--color-ink)]"></span>
          For India's innovation ecosystem
        </div>

        <h1 class="text-[2.25rem] sm:text-[3.25rem] leading-[1.05] font-bold tracking-tight">
          Where India's innovation
          <span class="text-[color:var(--color-accent)]">ecosystem connects.</span>
        </h1>

        <p class="mt-6 text-[18px] sm:text-[19px] text-[color:var(--color-ink-muted)] leading-relaxed">
          The Startup Club is a community for founders, aspiring entrepreneurs, investors, mentors, and the people building India's startup ecosystem. We publish across five pillars — innovation, fundraising, product and go-to-market, founder craft, and ecosystem and policy — so the conversation that moves Indian startups forward has a home.
        </p>
      </div>
    </div>

    <div class="mt-10 sm:mt-12">
      <div class="text-[12px] tracking-[0.14em] uppercase text-[color:var(--color-ink-soft)] font-semibold mb-4">
        Watch · Join virtually · Attend in person
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {featured.map((c, i) => (
          <a
            href={c.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`group block rounded-2xl border p-6 sm:p-7 no-underline transition-all hover:-translate-y-0.5 ${
              i === 0
                ? "bg-[color:var(--color-accent)] border-[color:var(--color-accent)] text-white hover:bg-[color:var(--color-accent-hover)]"
                : "bg-[color:var(--color-bg-elev)] border-[color:var(--color-line)] hover:border-[color:var(--color-ink)]"
            }`}
          >
            <div class={`flex items-center justify-between mb-4 ${i === 0 ? "text-white/85" : "text-[color:var(--color-ink-soft)]"}`}>
              <div class="text-[11px] tracking-[0.16em] uppercase font-semibold">{c.eyebrow}</div>
              <BrandIcon
                brand={c.brand}
                size={22}
                class={i === 0 ? "text-white" : "text-[color:var(--color-ink)]"}
              />
            </div>
            <div class={`text-[20px] sm:text-[22px] font-bold tracking-tight ${i === 0 ? "text-white" : "text-[color:var(--color-ink)]"}`}>
              {c.label}
            </div>
            <div class={`mt-2 text-[14.5px] leading-relaxed ${i === 0 ? "text-white/90" : "text-[color:var(--color-ink-muted)]"}`}>
              {c.sub}
            </div>
            <div class={`mt-5 inline-flex items-center gap-1 text-[14px] font-semibold ${i === 0 ? "text-white" : "text-[color:var(--color-ink)]"}`}>
              Open
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <span class="text-[13px] text-[color:var(--color-ink-soft)] font-semibold tracking-wide uppercase">Or follow on</span>
        <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[14.5px] font-semibold text-[color:var(--color-ink)] hover:opacity-70 no-underline transition-opacity">
          <BrandIcon brand="linkedin" size={16} />
          LinkedIn
        </a>
        <a href={xUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[14.5px] font-semibold text-[color:var(--color-ink)] hover:opacity-70 no-underline transition-opacity">
          <BrandIcon brand="x" size={16} />
          X
        </a>
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[14.5px] font-semibold text-[color:var(--color-ink)] hover:opacity-70 no-underline transition-opacity">
          <BrandIcon brand="instagram" size={16} />
          Instagram
        </a>
      </div>
    </div>
  </div>
</section>
