---
import Button from "../components/Button.astro";
import BrandIcon from "../components/BrandIcon.astro";

const linkedinUrl = "https://www.linkedin.com/company/the-startup-club-india";
const xUrl = "https://x.com/startupclublive";
const instagramUrl = "https://www.instagram.com/startupclub.live/";
---

<section id="home" class="scroll-mt-20">
  <div class="mx-auto max-w-[1120px] px-5 sm:px-8 pt-16 sm:pt-24 pb-14 sm:pb-20">
    <div class="max-w-[44rem]">
      <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] px-3 py-1 text-[12px] font-semibold tracking-wide uppercase text-[color:var(--color-ink)] mb-7">
        <span class="h-2 w-2 rounded-full bg-[color:var(--color-ink)]"></span>
        For India's innovation ecosystem
      </div>

      <h1 class="text-[2.25rem] sm:text-[3.25rem] leading-[1.05] font-bold tracking-tight">
        Where India's innovation
        <span class="text-[color:var(--color-accent)]">ecosystem connects.</span>
      </h1>

      <p class="mt-6 text-[18px] sm:text-[19px] text-[color:var(--color-ink-muted)] leading-relaxed">
        The Startup Club is a community for founders, aspiring entrepreneurs, investors, mentors, and the people building India's startup ecosystem. We publish across five pillars — innovation, fundraising, product and go-to-market, founder craft, and ecosystem and policy — so the conversation that moves Indian startups forward has a home.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={linkedinUrl} variant="primary" ariaLabel="Follow The Startup Club on LinkedIn">
          <BrandIcon brand="linkedin" size={16} />
          Follow on LinkedIn
        </Button>
        <Button href={xUrl} variant="tinted" ariaLabel="Follow The Startup Club on X">
          <BrandIcon brand="x" size={16} />
          Follow on X
        </Button>
        <Button href={instagramUrl} variant="ghost" ariaLabel="Follow The Startup Club on Instagram">
          <BrandIcon brand="instagram" size={16} />
          Instagram
        </Button>
      </div>

      <p class="mt-4 text-[14px] text-[color:var(--color-ink-soft)] max-w-[44rem]">
        <span class="font-semibold text-[color:var(--color-ink-muted)]">New content daily.</span>
        Posts go out across LinkedIn, X, and Instagram — pick whichever channel you live on and we'll meet you there.
      </p>

      <div class="mt-10 grid sm:grid-cols-3 gap-4 max-w-[44rem]">
        <div class="rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-4">
          <div class="text-[12px] uppercase tracking-wide text-[color:var(--color-ink-soft)] font-semibold">Who it's for</div>
          <div class="mt-1 text-[15px] font-semibold text-[color:var(--color-ink)]">Founders, investors, mentors</div>
        </div>
        <div class="rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-4">
          <div class="text-[12px] uppercase tracking-wide text-[color:var(--color-ink-soft)] font-semibold">Where</div>
          <div class="mt-1 text-[15px] font-semibold text-[color:var(--color-ink)]">LinkedIn · X · Instagram</div>
        </div>
        <div class="rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-4">
          <div class="text-[12px] uppercase tracking-wide text-[color:var(--color-ink-soft)] font-semibold">Cost</div>
          <div class="mt-1 text-[15px] font-semibold text-[color:var(--color-ink)]">Free · open to all</div>
        </div>
      </div>
    </div>
  </div>
</section>
