---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = new Date(post.data.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${post.data.title} — The Debate Club`}
  description={post.data.excerpt}
  pageType="article"
  article={{
    title: post.data.title,
    description: post.data.excerpt,
    datePublished: post.data.date.toISOString(),
    slug: post.slug,
  }}
>
  <article class="mx-auto max-w-[1120px] px-5 sm:px-8 pt-12 sm:pt-16 pb-16">
    <a href="/#blog" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-[color:var(--color-ink-muted)] no-underline hover:text-[color:var(--color-accent)]">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      All posts
    </a>

    <header class="mt-8 max-w-[42rem]">
      <div class="text-[12px] tracking-[0.14em] uppercase text-[color:var(--color-accent)] font-semibold mb-3">
        {post.data.tags.length > 0 ? post.data.tags[0] : "Post"}
      </div>
      <h1 class="text-3xl sm:text-[2.5rem] font-bold leading-[1.1] tracking-tight">
        {post.data.title}
      </h1>
      <div class="mt-4 text-[14px] text-[color:var(--color-ink-soft)] font-medium">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true"> · </span>
        The Debate Club
      </div>
    </header>

    <div class="prose-tdc mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
