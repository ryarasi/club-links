---
interface Article {
  title: string;
  description: string;
  datePublished: string;
  slug: string;
}

interface Props {
  home?: boolean;
  article?: Article;
  siteUrl: string;
}

const { home = false, article, siteUrl } = Astro.props;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "The Startup Club",
  alternateName: "Startup Club India",
  url: siteUrl,
  logo: `${siteUrl}/images/tsc-logo.png`,
  description:
    "The Startup Club is a community for India's founders, investors, mentors, and ecosystem enablers. We run virtual and in-person events, publish long-form video, and post daily across social.",
  areaServed: { "@type": "Country", name: "India" },
  sameAs: [
    "https://www.linkedin.com/company/the-startup-club-india",
    "https://www.youtube.com/@startupclublive",
    "https://x.com/startupclublive",
    "https://www.instagram.com/startupclub.live/",
    "https://www.meetup.com/the-startup-club/",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "The Startup Club",
  url: siteUrl,
  inLanguage: "en-IN",
  publisher: { "@type": "Organization", name: "The Startup Club", url: siteUrl },
};

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is The Startup Club?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The Startup Club is a community for India's innovation ecosystem — founders, aspiring entrepreneurs, investors, mentors, and ecosystem enablers. We run virtual and in-person events, publish long-form video on YouTube, and post daily across LinkedIn, X, and Instagram.",
      },
    },
    {
      "@type": "Question",
      name: "Who is The Startup Club for?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Early-stage founders, aspiring entrepreneurs, angel and institutional investors, mentors and operators, and anyone enabling India's startup ecosystem — incubators, accelerators, policy folks, and community builders.",
      },
    },
    {
      "@type": "Question",
      name: "How do I join or follow?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Follow @the-startup-club-india on LinkedIn, @startupclublive on X, and @startupclub.live on Instagram. Or scan the Clikkin QR on our home page to join the Startup Club space on Clikkin.",
      },
    },
    {
      "@type": "Question",
      name: "Is The Startup Club free?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Following The Startup Club and engaging with our content is free.",
      },
    },
  ],
};

const articleLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: article.title,
      description: article.description,
      datePublished: article.datePublished,
      author: { "@type": "Organization", name: "The Startup Club", url: siteUrl },
      publisher: {
        "@type": "Organization",
        name: "The Startup Club",
        logo: {
          "@type": "ImageObject",
          url: `${siteUrl}/images/tsc-logo.png`,
        },
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": `${siteUrl}/blog/${article.slug}/`,
      },
    }
  : null;
---

{home && (
  <>
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  </>
)}
{articleLd && (
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
)}
