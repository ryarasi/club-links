---
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-line)] mt-20 sm:mt-28">
  <div class="mx-auto max-w-[1120px] px-5 sm:px-8 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex items-center gap-2.5 text-[color:var(--color-ink-muted)]">
      <img src="/images/tsc-logo.png" alt="" width="28" height="28" class="rounded-full ring-1 ring-[color:var(--color-line)] bg-[color:var(--color-ink)]" />
      <span class="text-sm">© {year} The Startup Club</span>
    </div>
    <p class="text-[13px] text-[color:var(--color-ink-soft)] leading-relaxed max-w-xl">
      Views expressed in our content are those of individual contributors and do not represent the views of The Startup Club as a platform.
    </p>
  </div>
</footer>
