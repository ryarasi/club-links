---
const links = [
  { href: "/#home", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/#blog", label: "Blog" },
  { href: "/#contact", label: "Contact" },
];
const whatsappUrl = "https://chat.whatsapp.com/J7HajIvMSUfLnS0W47Un7M";
---

<header class="sticky top-0 z-50 backdrop-blur bg-[color:var(--color-bg)]/85 border-b border-[color:var(--color-line)]">
  <nav
    class="mx-auto max-w-[1120px] px-5 sm:px-8 h-16 flex items-center justify-between"
    aria-label="Primary"
  >
    <a href="/#home" class="flex items-center gap-2.5 text-[color:var(--color-ink)] no-underline font-semibold tracking-tight">
      <img
        src="/images/logo.png"
        alt=""
        width="28"
        height="28"
        class="rounded-full ring-1 ring-[color:var(--color-line)]"
      />
      <span class="text-[15px] sm:text-base">The Debate Club</span>
    </a>

    <ul class="hidden md:flex items-center gap-7 m-0 p-0 list-none">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-[14.5px] text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink)] no-underline font-medium transition-colors"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-accent)] hover:bg-[color:var(--color-accent-hover)] text-white no-underline px-3.5 sm:px-4 py-2 text-[13.5px] sm:text-sm font-semibold transition-colors"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 2.1.55 4.16 1.6 5.97L2 22l4.25-1.11a9.86 9.86 0 0 0 5.79 1.84c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.84 14.04c-.25.7-1.45 1.34-2.02 1.39-.51.05-1.16.07-1.87-.12-.43-.13-.99-.32-1.7-.62-2.99-1.29-4.95-4.3-5.1-4.5-.15-.2-1.22-1.62-1.22-3.09 0-1.47.77-2.19 1.04-2.49.27-.3.59-.37.79-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.84 2.07.91 2.22.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.32.39-.45.52-.15.15-.3.31-.13.61.18.3.79 1.31 1.7 2.12 1.17 1.04 2.16 1.36 2.46 1.51.3.15.47.13.65-.07.17-.2.74-.86.94-1.16.2-.3.39-.25.66-.15.27.1 1.7.8 1.99.95.3.15.5.22.57.34.07.12.07.7-.18 1.4z" />
      </svg>
      <span>Join Community</span>
    </a>
  </nav>
</header>
