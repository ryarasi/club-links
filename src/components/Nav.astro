---
import BrandIcon from "./BrandIcon.astro";

const links = [
  { href: "/#home", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/#clikkin", label: "Join" },
  // { href: "/#blog", label: "Blog" }, // re-enable when we have posts
  { href: "/#contact", label: "Follow" },
];
const linkedinUrl = "https://www.linkedin.com/company/the-startup-club-india";
---

<header class="sticky top-0 z-50 backdrop-blur bg-[color:var(--color-bg)]/85 border-b border-[color:var(--color-line)]">
  <nav
    class="mx-auto max-w-[1120px] px-5 sm:px-8 h-[80px] sm:h-[88px] flex items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a href="/#home" class="flex items-center no-underline" aria-label="The Startup Club — home">
      <img
        src="/images/tsc-logo.png"
        alt="The Startup Club"
        width="112"
        height="112"
        class="block h-14 sm:h-16 w-auto rounded-full bg-[color:var(--color-ink)] ring-1 ring-[color:var(--color-line)]"
      />
    </a>

    <ul class="hidden md:flex items-center gap-7 m-0 p-0 list-none">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-[14.5px] text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink)] no-underline font-medium transition-colors"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-accent)] hover:bg-[color:var(--color-accent-hover)] text-white no-underline px-3.5 sm:px-4 h-10 text-[13.5px] sm:text-sm font-semibold transition-colors"
      >
        <BrandIcon brand="linkedin" size={16} />
        <span>Follow on LinkedIn</span>
      </a>
    </div>
  </nav>
</header>
