---
import BrandIcon from "./BrandIcon.astro";

const links = [
  { href: "/#home", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/#blog", label: "Blog" },
  { href: "/#contact", label: "Contact" },
];
const whatsappUrl = "https://chat.whatsapp.com/J7HajIvMSUfLnS0W47Un7M";
const youtubeUrl = "https://www.youtube.com/channel/UCdzpn4pK63658vlhRQexJVw";
---

<header class="sticky top-0 z-50 backdrop-blur bg-[color:var(--color-bg)]/85 border-b border-[color:var(--color-line)]">
  <nav
    class="mx-auto max-w-[1120px] px-5 sm:px-8 h-[72px] flex items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a href="/#home" class="flex items-center gap-3 text-[color:var(--color-ink)] no-underline font-semibold tracking-tight">
      <img
        src="/images/logo.png"
        alt=""
        width="44"
        height="44"
        class="rounded-[10px] ring-1 ring-[color:var(--color-line)]"
      />
      <span class="text-base sm:text-[17px]">The Debate Club</span>
    </a>

    <ul class="hidden md:flex items-center gap-7 m-0 p-0 list-none">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-[14.5px] text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink)] no-underline font-medium transition-colors"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={youtubeUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Watch our debates on YouTube"
        title="Watch on YouTube"
        class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#FF0033] hover:bg-[#cc0029] text-white no-underline transition-colors"
      >
        <BrandIcon brand="youtube" size={18} />
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-accent)] hover:bg-[color:var(--color-accent-hover)] text-white no-underline px-3.5 sm:px-4 h-10 text-[13.5px] sm:text-sm font-semibold transition-colors"
      >
        <BrandIcon brand="whatsapp" size={16} />
        <span>Join Community</span>
      </a>
    </div>
  </nav>
</header>
