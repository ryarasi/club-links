---
interface Props {
  href: string;
  title: string;
  date: string;
  excerpt: string;
  tags?: string[];
}
const { href, title, date, excerpt, tags = [] } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a
  href={href}
  class="group block rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg-elev)] p-6 sm:p-7 no-underline hover:border-[color:var(--color-accent)] transition-colors"
>
  <div class="flex items-center gap-3 text-[12px] tracking-wide uppercase text-[color:var(--color-ink-soft)] font-semibold mb-3">
    <time datetime={date}>{formattedDate}</time>
    {tags.length > 0 && (
      <>
        <span aria-hidden="true">·</span>
        <span>{tags.slice(0, 2).join(" · ")}</span>
      </>
    )}
  </div>
  <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[color:var(--color-ink)] group-hover:text-[color:var(--color-accent)] transition-colors">
    {title}
  </h3>
  <p class="mt-3 text-[15.5px] text-[color:var(--color-ink-muted)] leading-relaxed">
    {excerpt}
  </p>
  <div class="mt-5 inline-flex items-center gap-1 text-[14px] font-semibold text-[color:var(--color-accent)]">
    Read post
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 5l7 7-7 7" />
    </svg>
  </div>
</a>
