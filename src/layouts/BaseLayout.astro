---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: "website" | "article";
  /** When true, emit Organization + Event + FAQPage JSON-LD (only on home). */
  homeStructuredData?: boolean;
  /** Article-specific structured data (only on blog posts). */
  article?: {
    title: string;
    description: string;
    datePublished: string;
    slug: string;
  };
  canonical?: string;
}

const {
  title = "The Debate Club: Civil Public Discourse, Every Saturday",
  description = "A neutral community for civil public discourse. Live voice debates on Zoom every Saturday at 11am IST. Topics are community-suggested and member-voted. Join the WhatsApp community to participate.",
  ogImage = "/og-image.png",
  pageType = "website",
  homeStructuredData = false,
  article,
  canonical,
} = Astro.props;

const siteUrl = "https://thedebateclub.info";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const ogImageAlt = "The Debate Club: civil public discourse, every Saturday";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#6768fd" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="The Debate Club" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <StructuredData
      home={homeStructuredData}
      article={article}
      siteUrl={siteUrl}
    />

    <!-- microanalytics.io -->
    <script
      data-host="https://app.microanalytics.io"
      data-dnt="false"
      src="https://app.microanalytics.io/js/script.js"
      id="ZwSg9rf6GA"
      async
      defer
    ></script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wozawgafck");
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
